# Copy to .env and fill in. .env is gitignored; its values are never logged, staged or built into an image.
# This file holds the model keys and their spend ceilings: OPENROUTER_API_KEY for the default backend (the chat,
# the analyst jobs, the arms), OPENAI_API_KEY for --backend openai. The serving stack's own variables
# (Postgres, MinIO, Redis, the seed URL, OTLP) live in pipeline/.env.example.

OPENAI_API_KEY=sk-...

# Which model answers. Run `uv run ue openai models` to see what this key can actually reach before spending.
OPENAI_MODEL=gpt-5-mini

# Hard ceiling on cumulative spend, in US dollars, across every run on this machine.
# The ledger at pipeline/data/openai_spend.jsonl is the running total; a call that would cross this
# line is refused before it is sent, not after.
OPENAI_MAX_SPEND_USD=2.00

# Price per million tokens, used only to turn measured token counts into an estimated cost.
# Token counts are facts the API returns. Dollars are this arithmetic, so set these to your actual
# rates or the ledger will be confidently wrong.
OPENAI_PRICE_IN_PER_MTOK=0.25
OPENAI_PRICE_OUT_PER_MTOK=2.00

# Ceiling on a single answer, so one runaway reply cannot eat the budget.
OPENAI_MAX_OUTPUT_TOKENS=1400

# OpenRouter: any OpenAI-compatible model for an analyst role (`--backend auto` routes vendor/model ids here).
# The provider reports each call's cost; the ceiling below is this family's own, checked beside the total.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MAX_SPEND_USD=25.00
OPENROUTER_MAX_OUTPUT_TOKENS=0   # 0: the reasoning budget for the effort plus the answer room; set to override

# Image input on the OpenAI backend (the extractor's page reads through an API key). The adapter sends page
# images only to models it knows take them (gpt-5*, gpt-4o*, gpt-4.1*, o1/o3/o4*); name any other vision model
# here, comma-separated, and a request that carries an image for a model not on the list is refused before it
# is sent.
OPENAI_VISION_MODELS=
