
# Serving stack (docker compose up -d). The pipeline reads these; defaults match docker-compose.yml.
# Values here are never logged. Compose passes this file into the app; on the host, export what you need.
UE_PG_DSN=postgresql://ue:ue@127.0.0.1:5432/ue
UE_S3_ENDPOINT=http://127.0.0.1:9000
UE_S3_KEY=ue-minio
UE_S3_SECRET=ue-minio-secret
UE_REDIS_URL=redis://127.0.0.1:6379/0

# The seed pack over S3 (`ue store seed push|pull`, and `ensure` on the app's first start). The client reads the
# standard AWS names first (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION); when those are unset
# the UE_S3_KEY/UE_S3_SECRET pair above (what MinIO is started with) stands in. Any S3 works the same way with
# UE_S3_ENDPOINT unset. UE_SEED_URL is where `ensure` pulls from when there is no store and no pack on disk:
# an s3://bucket/prefix that push wrote, or an https:// directory holding manifest.json and <hash>/ (pull only).
# UE_SEED_URL=s3://seeds/latest

# Traces over OTLP/HTTP (protobuf). Unset: spans stay in each run's spans.jsonl and the MLflow mirror, and the
# OpenTelemetry exporter is not imported. Set: every span is also exported to this URL, batched from a bounded
# queue, flushed at the end of each run, never blocking a model call; a backend that is down costs one warning.
# A bare host gets /v1/traces appended. UE_OTLP_HEADERS carries an auth header for a hosted backend as
# name=value[,name=value]; the values are never logged.
# UE_OTLP_ENDPOINT=http://127.0.0.1:4318
# UE_OTLP_HEADERS=Authorization=Bearer%20<token>
