{
  "name": "legacy-reader-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:public": "tsc -p tsconfig.json && VITE_PUBLIC_SAFE=1 vite build && node scripts/check-public-safe.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check src plugins scripts",
    "format": "biome format --write src plugins scripts",
    "test": "vitest run",
    "e2e": "playwright test",
    "validate:data": "vite-node scripts/validate-data.ts",
    "api:types": "npx --yes openapi-typescript@7.13.0 src/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-virtual": "3.14.13",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "d3-scale": "4.0.2",
    "lucide-react": "1.47.0",
    "maplibre-gl": "6.10.0",
    "minisearch": "7.2.0",
    "motion": "13.4.0",
    "openapi-fetch": "^0.17.0",
    "pmtiles": "^4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "wouter": "3.11.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-scale": "4.0.9",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.14.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vite-node": "6.0.0",
    "vitest": "4.1.11"
  }
}
